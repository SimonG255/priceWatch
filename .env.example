# Copy this file to .env.local and fill in the runtime secrets.
# Example: OPENAI_API_KEY=sk-...
# Public Supabase values used by the frontend and server checks
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side Supabase Postgres connection string from Project Settings > Database > Connect
DATABASE_URL=
# Comma-separated list of admin emails (exact addresses)
ADMIN_EMAILS=
# Server-side secrets
OPENAI_API_KEY=
# Optional: override the discovery model (defaults to gpt-5.6-luna)
OPENAI_DISCOVERY_MODEL=
# Required for the protected background schedule endpoint. Use a random value
# of at least 16 characters; Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=
# Optional organisation-approved page rendering service. Both values are
# server-only; rendering is additionally enabled per admin store profile.
SCRAPER_RENDERER_URL=
SCRAPER_RENDERER_TOKEN=
# Optional comma- or newline-separated user-agent pool for public scraper requests.
# The default is the identifiable Nexus user-agent above the pool.
SCRAPER_USER_AGENTS=
# Optional language preference sent consistently for one scan session.
SCRAPER_ACCEPT_LANGUAGE=en-US,en;q=0.8
# Optional comma- or newline-separated HTTP(S) proxy URLs. Proxies are used
# round-robin per outbound page request and should be supplied server-side only.
SCRAPER_PROXY_URLS=
# Optional comma-separated hostname allow/block rules. A block always wins.
SCRAPER_ALLOWED_DOMAINS=
SCRAPER_BLOCKED_DOMAINS=
# Optional alert delivery endpoints configured by an administrator.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_WEBHOOK_URL=
# Enterprise contact form delivery. The dedicated webhook is optional and
# falls back to ALERT_EMAIL_WEBHOOK_URL when omitted.
CONTACT_EMAIL_WEBHOOK_URL=
CONTACT_EMAIL=
